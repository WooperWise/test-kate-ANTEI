# Copy to .env and adjust. All values are optional: defaults target the local vLLM.

# OpenAI-compatible endpoint (local vLLM by default; point to any cloud provider if needed)
OPENAI_BASE_URL=http://localhost:8000/v1
OPENAI_API_KEY=dummy

# Model name as served by the endpoint
MITO_MODEL=Qwen3.8-27B-FP8

# Optional: NCBI E-utilities API key (raises PubMed rate limit from 3 to 10 req/s)
# NCBI_API_KEY=
